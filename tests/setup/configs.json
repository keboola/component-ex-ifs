  {
    "name": "10_happy_full",
    "description": "Full fetch + full load of VoucherRowSet -> one table with an authoritative schema manifest; IFS meta-fields (@odata.*/luname/keyref/Objgrants) are stripped from the output columns.",
    "config": {
      "action": "run",
      "parameters": {
        "tenant_id": "acme",
        "realm": "acme1",
        "client_id": "acme_client",
        "#client_secret": "DUMMY_SECRET",
        "service": "VoucherRowsAnalysis",
        "entity_set": "VoucherRowSet",
        "columns": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo", "VoucherDate", "Account", "Amount", "CurrencyCode"],
        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "load_type": "full_load",
        "filter": "AccountingYear eq 2026"
      }
    }
  },
  {
    "name": "11_date_window",
    "description": "A closed Date window (date_start + date_end on VoucherDate) -> a stateless `(filter) and (VoucherDate ge date_start) and (VoucherDate lt date_end)` $filter is applied; no state, no cursor.",
    "config": {
      "action": "run",
      "parameters": {
        "tenant_id": "acme",
        "realm": "acme1",
        "client_id": "acme_client",
        "#client_secret": "DUMMY_SECRET",
        "service": "VoucherRowsAnalysis",
        "entity_set": "VoucherRowSet",
        "columns": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo", "VoucherDate", "Account", "Amount", "CurrencyCode"],
        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "date_field": "VoucherDate",
        "date_start": "2020-01-01",
        "date_end": "2027-01-01",
        "load_type": "incremental_load",
        "filter": "AccountingYear eq 2026"
      }
    }
  },
  {
    "name": "12_date_backfill",
    "description": "An open-ended backfill (date_start only on VoucherDate) -> a stateless `(filter) and (VoucherDate ge date_start)` $filter is applied; re-runnable to re-pull history.",
    "config": {
      "action": "run",
      "parameters": {
        "tenant_id": "acme",
        "realm": "acme1",
        "client_id": "acme_client",
        "#client_secret": "DUMMY_SECRET",
        "service": "VoucherRowsAnalysis",
        "entity_set": "VoucherRowSet",
        "columns": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo", "VoucherDate", "Account", "Amount", "CurrencyCode"],
        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "date_field": "VoucherDate",
        "date_start": "2020-01-01",
        "load_type": "incremental_load",
        "filter": "AccountingYear eq 2026"
      }
    }
  },
  {
    "name": "13_paging_multi",
    "description": "page_size=60 over a >60-row result forces the multi-page paging loop ($skip fallback) to collapse into one table.",
    "config": {
      "action": "run",
      "parameters": {
        "tenant_id": "acme",
        "realm": "acme1",
        "client_id": "acme_client",
        "#client_secret": "DUMMY_SECRET",
        "service": "VoucherRowsAnalysis",
        "entity_set": "VoucherRowSet",
        "columns": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo", "VoucherDate"],
        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "load_type": "full_load",
        "filter": "AccountingYear eq 2026",
        "advanced": {
          "page_size": 60
        }
      }
    }
  },
