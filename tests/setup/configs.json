  {
    "name": "10_happy_full",
    "description": "Full fetch + full load of VoucherRowSet -> one table with an authoritative schema manifest; IFS meta-fields (@odata.*/luname/keyref/Objgrants) are stripped from the output columns.",
    "config": {
      "action": "run",
      "parameters": {
        "tenant_id": "acme",
        "realm": "acme1",
        "client_id": "acme_client",
        "#client_secret": "DUMMY_SECRET",
        "service_account": "svc_account",
        "service": "VoucherRowsAnalysis",
        "entity_set": "VoucherRowSet",
        "columns": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo", "VoucherDate", "Account", "Amount", "CurrencyCode"],
        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "fetch_type": "full_fetch",
        "load_type": "full_load",
        "filter": "AccountingYear eq 2026"
      }
    }
  },
  {
    "name": "11_incremental_init",
