        "primary_key": ["Company", "VoucherType", "AccountingYear", "VoucherNo", "RowNo"],
        "fetch_type": "incremental_fetch",
        "incremental_field": "VoucherDate",
        "load_type": "incremental_load",
        "filter": "AccountingYear eq 2026"
      }
    }
  },
